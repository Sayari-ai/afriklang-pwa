{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verdict push request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "events"
  ],
  "properties": {
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "sayari_recording_id",
          "mission_id",
          "source_sha256",
          "status",
          "reason",
          "original_duration_s",
          "occurred_at"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "sayari_recording_id": {
            "type": "string",
            "maxLength": 40
          },
          "mission_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "enum": [
              "pre_annotated",
              "accepted",
              "rejected"
            ]
          },
          "reason": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "enum": [
                  "level",
                  "duration",
                  "silence",
                  "variety",
                  "banned_topic",
                  "reading_gap",
                  "speaker_balance",
                  "other"
                ]
              }
            ]
          },
          "language_flag": {
            "type": "boolean"
          },
          "original_duration_s": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 3600
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "rejected"
                }
              }
            },
            "then": {
              "properties": {
                "reason": {
                  "enum": [
                    "level",
                    "duration",
                    "silence",
                    "variety",
                    "banned_topic",
                    "reading_gap",
                    "speaker_balance",
                    "other"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  }
}