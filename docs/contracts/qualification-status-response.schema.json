{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Qualification tests: status (README §4.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tests",
    "unknown"
  ],
  "properties": {
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id",
          "source",
          "status",
          "items",
          "annotated",
          "reviewed_items",
          "result"
        ],
        "properties": {
          "test_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "source": {
            "enum": [
              "clips",
              "reference",
              "staff"
            ]
          },
          "status": {
            "enum": [
              "open",
              "submitted",
              "reviewed",
              "cancelled"
            ]
          },
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "annotated": {
            "type": "integer",
            "minimum": 0
          },
          "reviewed_items": {
            "type": "integer",
            "minimum": 0
          },
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "agree",
                  "total",
                  "cer",
                  "pitfalls_ok"
                ],
                "properties": {
                  "agree": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "total": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cer": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "pitfalls_ok": {
                    "type": "boolean"
                  }
                }
              }
            ]
          },
          "submitted_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "unknown": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
