{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verdict push response",
  "type": "object",
  "required": [
    "results"
  ],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "outcome"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "outcome": {
            "enum": [
              "applied",
              "duplicate",
              "parked",
              "stale",
              "quarantined",
              "invalid"
            ]
          }
        }
      }
    }
  }
}