# ─────────────────────────────────────────────────────────────────────
# Afriklang PWA environment variables
#
# Local dev:  copy this file to `.env.local` and fill in the values.
# Amplify:    set the same variables in the Amplify console under
#             App settings -> Environment variables (they are injected
#             into the build, and into .env.production by amplify.yml).
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time,
# so they must be present when `npm run build` runs.
# ─────────────────────────────────────────────────────────────────────

# Supabase project the PWA talks to (Edge Functions + Storage).
# REQUIRED without these the path-setup screen shows a
# "backend not configured" error. These are public values by design
# (the anon key is safe to expose; row-level security guards the data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sayari audio-upload backend base URL.
# OPTIONAL defaults to the production Railway URL hard-coded in
# src/app/api/audio-upload/route.ts. Override only to point the
# recorder at a different Sayari deployment.
#
#   SAYARI_BASE_URL            -> read server-side in the /api/audio-upload
#                                 Route Handler (the Amplify SSR compute).
#   NEXT_PUBLIC_SAYARI_BASE_URL-> build-time public fallback.
# If both are set, SAYARI_BASE_URL wins.
SAYARI_BASE_URL=
NEXT_PUBLIC_SAYARI_BASE_URL=

# Sayari upload authentication key.
# REQUIRED for audio submission forwarded by the /api/audio-upload
# Route Handler to Sayari as the `X-Upload-Key` HTTP header. This is a
# SECRET: server-side only, so no NEXT_PUBLIC_ variant. The name must
# keep the SAYARI_ prefix (amplify.yml greps for it) and must not
# contain hyphens (Amplify/Lambda reject them in env var names).
SAYARI_UPLOAD_KEY=

# Header carrying the client's address, set by the CDN in front of the app
# (OPTIONAL, default "cloudfront-viewer-address"; add it to the CloudFront
# origin request policy). Used only to slow down an address that keeps
# sending bad sign-in tokens; a valid token always passes. Without the
# header the proxy uses the LAST X-Forwarded-For hop (never the first,
# which the client can forge). Set to an empty value to skip it.
SAYARI_UPLOAD_CLIENT_IP_HEADER=

# Uploads without an X-Campaign-Ticket header are refused by the proxy
# (OPTIONAL, default: required). Set to "false" ONLY while the app runs
# against a dashboard that issues no upload tickets yet (local tests of an
# old dashboard). Never in production: without a ticket Sayari trusts the
# speaker, campaign and mission ids typed in the form.
SAYARI_UPLOAD_REQUIRE_TICKET=

# PostHog: error tracking, product analytics, replay after an error.
# All Afriklang apps share one PostHog project; this app tags its events
# with app=speaker-app.
#
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN  OPTIONAL. The project's public phc_ key.
#                                    Empty: PostHog is a complete no-op
#                                    (nothing loaded, nothing sent).
# NEXT_PUBLIC_POSTHOG_HOST           OPTIONAL, default https://d.afriklang.com
#                                    (the reverse proxy to PostHog US Cloud).
# NEXT_PUBLIC_POSTHOG_DEBUG          OPTIONAL. "1" turns PostHog on for
#                                    localhost (off there otherwise) and logs
#                                    the SDK to the console. Never in Amplify.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_DEBUG=

# Source-map upload at BUILD time (Amplify console only; not needed locally).
# Both must be set, or the upload is skipped and the build is the plain one.
# POSTHOG_API_KEY is a SECRET *personal* API key (error tracking write);
# no NEXT_PUBLIC_ prefix, and amplify.yml does not copy it to .env.production.
# POSTHOG_API_HOST: OPTIONAL, default https://us.posthog.com (the PostHog API,
# not the ingestion proxy above).
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=

# ─────────────────────────────────────────────────────────────────────
# Google sign-in (Supabase Auth provider) BACKEND config, not app env
#
# These are NOT read by `next build` and must NOT be set in Amplify.
# They exist so `supabase config push` can configure the hosted Auth
# provider from `supabase/config.toml` (which references them via
# `env(...)`). Dashboard alternative: paste the same values under
# Authentication -> Providers -> Google.
#
# Creating the credentials (Google Cloud Console -> APIs & Services ->
# Credentials -> Create credentials -> OAuth client ID -> Web app):
#   * Authorized redirect URI (the only one Google needs):
#       https://elosonbrvmsfgrxemtso.supabase.co/auth/v1/callback
#   * Client ID ends in `.apps.googleusercontent.com`.
#   * The client secret is a SECRET it lives here and in the
#     Supabase provider config only. Never NEXT_PUBLIC_*, never
#     committed, never in Amplify.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Public origin of the deployed PWA (no trailing slash), e.g. the
# Amplify domain. Becomes the Auth `site_url`: the OAuth redirect
# back to `<origin>/login` is only honoured if it matches this or the
# `additional_redirect_urls` allowlist in supabase/config.toml.
# For a dev-only setup use http://localhost:3000.
# REQUIRED before running `supabase config push` (an empty value
# would push an empty site_url and break the login redirect).
SUPABASE_AUTH_SITE_URL=